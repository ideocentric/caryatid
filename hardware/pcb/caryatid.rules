
(rules PCB caryatid.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 2500.0)
    (clearance 2000.0)
    (clearance 1250.0 (type smd_to_turn_gap))
    (clearance 2000.0 (type smd))
    (clearance 5000.0 (type "board_edge"))
  )
  (padstack "Via_7000_3000"
    (shape
      (circle F.Cu 7000.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 7000.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via_7000_3000" "Via_7000_3000" default
  )
  (via_rule
    default "Via_7000_3000"
  )
  (via_rule
    default "Via_7000_3000"
  )
  (class default
    +3V3 +3V3A +5V "+5V_RAW" "/audio/GAINLEG_L" "/audio/GAINLEG_R" "/audio/MIC_L" "/audio/MIC_R"
    "/audio/MIC_RTN" "/audio/OPA_L_N" "/audio/OPA_L_O" "/audio/OPA_R_N" "/audio/OPA_R_O" "/audio/OUT_L_J" "/audio/OUT_R_J" "/audio/VBIAS_L"
    "/audio/VBIAS_R" "/panel-io/A0_W" "/panel-io/A1_W" "/panel-io/A2_W" "/panel-io/A3_W" "/panel-io/A6_W" "/panel-io/A7_W" "/panel-io/A8_W"
    "/panel-io/A9_W" "/panel-io/D0_S" "/panel-io/D1_S" "/panel-io/D2_S" "/panel-io/D3_S" "/panel-io/D4_S" "/panel-io/D5_S" "/panel-io/D6_S"
    "/panel-io/RGB_B" "/panel-io/RGB_G" "/panel-io/RGB_R" "/panel-io/SW1_F" "/panel-io/SW1_RAW" "/panel-io/SW2_F" "/panel-io/SW2_RAW" "/panel-io/SW3_F"
    "/panel-io/SW3_RAW" "/power/CHG_LED" "/power/DC_IN" "/power/EN_SW" /power/FB /power/ILIM /power/ISET /power/LAMP
    "/power/PGOOD_LED" /power/SW /power/TMR /power/TS "/seed/A10_DIV" "/seed/A11_DIV" "/seed/PGOOD_LEG" A0
    A1 A10 A11 A2 A3 A4 A5 A6
    A7 A8 A9 "AUDIO_IN_L" "AUDIO_IN_R" "AUDIO_OUT_L" "AUDIO_OUT_R" D0
    D1 D10 D11 D12 D13 D14 D2 D26
    D27 D29 D3 D30 D4 D5 D6 D7
    D8 D9 VBAT "VIN_DC" VOUT ~{CHG} ~{PGOOD}
    (clearance_class default)
    (via_rule default)
    (rule
      (width 2500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)