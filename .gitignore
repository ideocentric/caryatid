# ---------------------------------------------------------------------------
# KiCad
#
# Committed: the editable design. Ignored: anything regenerable from it, and
# anything that is per-user editor state rather than design data.
# ---------------------------------------------------------------------------
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
~*.*
_autosave-*

# Fabrication output. Regenerable, and drifts from the board file within about
# two revisions. Released archives belong on a tagged release, not in the tree.
gerbers/
fab/
*.gbr
*.gbrjob
*.drl
*.xln
*-pos.csv
*.step.zip
*.d356

# Simulation and analysis scratch
*.raw
*.op.raw
spice*.net

# ---------------------------------------------------------------------------
# Local drop zone -- datasheets, vendor files, scratch. Never committed.
# ---------------------------------------------------------------------------
local/

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
# Finder custom folder icon -- the real name ends in two carriage returns
Icon?

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
*.cab
*.msi
*.msix
*.msm
*.msp

